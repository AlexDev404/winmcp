# Copy this file to .env.local and fill in the values you need.
# .env.local is loaded automatically on startup and is gitignored.

# Set to "http" to run as a standalone Streamable HTTP MCP server instead of stdio.
# MCP_TRANSPORT=http

# Interface to bind when MCP_TRANSPORT=http. Binding beyond localhost is only safe
# with MCP_AUTH_TOKEN set below.
# MCP_HOST=127.0.0.1

# Port to listen on when MCP_TRANSPORT=http.
# MCP_PORT=3000

# Shared secret for the HTTP transport. Required for anything but localhost-only use.
# Accepted either as "Authorization: Bearer <token>" directly, or via the OAuth login
# page at /authorize (used by clients like Claude.ai custom connectors).
# MCP_AUTH_TOKEN=change-me-to-a-long-random-value

# Externally-reachable base URL for this server (e.g. behind a reverse proxy or tunnel).
# Required for OAuth to work correctly when not running on localhost - OAuth issuer URLs
# must be https:// unless the host is localhost/127.0.0.1.
# MCP_PUBLIC_URL=https://mcp.example.com

# Maximum file size (in bytes) the download_file tool will read. Applies to both transports.
# Default is 10485760 (10 MB); binary files are base64-encoded in the response (~33% larger).
# MCP_MAX_DOWNLOAD_BYTES=10485760
